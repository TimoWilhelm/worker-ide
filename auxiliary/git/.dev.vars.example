# Git worker secrets (auxiliary/git/wrangler.jsonc)
# Copy this file to .dev.vars and fill in the values.

# ECDSA P-256 key pair for external git access JWTs.
# The public key verifies tokens on incoming Smart HTTP requests.
# The private key signs tokens via the signJwt RPC method.
#
# Generate with:
#   openssl ecparam -genkey -name prime256v1 -noout -out ec-private.pem
#   openssl pkcs8 -topk8 -nocrypt -in ec-private.pem -out private.pem
#   openssl ec -in ec-private.pem -pubout -out public.pem
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
