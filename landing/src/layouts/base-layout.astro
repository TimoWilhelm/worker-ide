---
import '../styles/global.css';
import { type LandingPageMetadataInput, resolveLandingPageMetadata } from '../lib/site-metadata';
import { meta } from '../../../shared/meta';

interface Props {
	metadata?: LandingPageMetadataInput;
}

const { metadata } = Astro.props;
const resolvedMetadata = resolveLandingPageMetadata({
	currentUrl: Astro.url,
	siteOrigin: Astro.site?.href ?? meta.landingSiteUrl,
	metadata: metadata ?? { title: meta.title, description: meta.description },
	canonicalUrl: metadata?.canonicalUrl,
});
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<!-- Primary SEO -->
		<title>{resolvedMetadata.title}</title>
		<meta name="description" content={resolvedMetadata.description} />
		<link rel="canonical" href={resolvedMetadata.canonicalUrl} />
		<meta name="robots" content={resolvedMetadata.robots} />
		<meta name="googlebot" content={resolvedMetadata.googlebot} />
		<meta name="theme-color" content={resolvedMetadata.themeColor} />
		<meta name="application-name" content={resolvedMetadata.applicationName} />
		<meta name="format-detection" content={resolvedMetadata.formatDetection} />
		{resolvedMetadata.googleSiteVerification && <meta name="google-site-verification" content={resolvedMetadata.googleSiteVerification} />}

		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- Sitemap -->
		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- Open Graph -->
		<meta property="og:type" content={resolvedMetadata.openGraphType} />
		<meta property="og:url" content={resolvedMetadata.canonicalUrl} />
		<meta property="og:title" content={resolvedMetadata.title} />
		<meta property="og:description" content={resolvedMetadata.description} />
		<meta property="og:image" content={resolvedMetadata.openGraphImage.absoluteUrl} />
		<meta property="og:image:secure_url" content={resolvedMetadata.openGraphImage.absoluteUrl} />
		<meta property="og:image:type" content={resolvedMetadata.openGraphImage.type} />
		<meta property="og:image:width" content={String(resolvedMetadata.openGraphImage.width)} />
		<meta property="og:image:height" content={String(resolvedMetadata.openGraphImage.height)} />
		<meta property="og:image:alt" content={resolvedMetadata.openGraphImage.alt} />
		<meta property="og:site_name" content={resolvedMetadata.applicationName} />
		<meta property="og:locale" content={resolvedMetadata.locale} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content={resolvedMetadata.twitterCard} />
		<meta name="twitter:title" content={resolvedMetadata.title} />
		<meta name="twitter:description" content={resolvedMetadata.description} />
		<meta name="twitter:image" content={resolvedMetadata.openGraphImage.absoluteUrl} />
		<meta name="twitter:image:alt" content={resolvedMetadata.openGraphImage.alt} />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
			rel="stylesheet"
		/>

		<!-- JSON-LD structured data -->
		<script is:inline type="application/ld+json" set:html={JSON.stringify(resolvedMetadata.structuredData)} />
	</head>
	<body class="min-h-screen overflow-x-hidden bg-bg-primary text-text-primary">
		<slot />
	</body>
</html>
