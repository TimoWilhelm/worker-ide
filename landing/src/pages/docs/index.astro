---
import { docsTopics } from '../../data/docs-content';
import type { LandingPageMetadataInput } from '../../lib/site-metadata';
import DocsLayout from '../../layouts/docs-layout.astro';

const metadata = {
	canonicalUrl: 'https://codemaxxing.ai/docs',
	description: 'Codemaxxing Documentation.',
	title: 'Codemaxxing — Docs',
} satisfies LandingPageMetadataInput;
---

<DocsLayout metadata={metadata}>
	<section class="docs-hero">
		<p class="docs-kicker">Architecture</p>
		<h1>Codemaxxing architecture</h1>
		<p>Preview, realtime state, AI runs, tests, Git, and deploys share one durable project model.</p>
	</section>

	<section class="docs-topic-list-section" aria-label="Architecture sections">
		<ul class="docs-topic-list">
			{
				docsTopics.map((topic) => (
					<li>
						<a href={`/docs/${topic.slug}`}>
							<span>{topic.title}</span>
							<small>{topic.description}</small>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</DocsLayout>
