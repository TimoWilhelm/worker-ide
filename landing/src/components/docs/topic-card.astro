---
import type { DocsTopic } from '../../data/docs-content';

interface Props {
	topic: DocsTopic;
}

const { topic } = Astro.props;
const accentVariable = `--docs-${topic.accent}`;
---

<a href={`/docs/${topic.slug}`} class="docs-topic-card" style={`--docs-accent: var(${accentVariable});`}>
	<p class="docs-topic-kicker">{topic.title}</p>
	<h3>{topic.tagline}</h3>
	<p>{topic.laneDescription}</p>
	<span class="docs-topic-link">Read architecture {'->'}</span>
</a>
