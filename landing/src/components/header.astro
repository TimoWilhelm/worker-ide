---
import { ArrowRight, Hexagon } from '@lucide/astro';

const appUrl = 'https://codemaxxing.app';
const isHomePage = Astro.url.pathname === '/';

const navigationLinks = [
	{ label: 'Features', href: isHomePage ? '#features' : '/#features' },
	{ label: 'Docs', href: '/docs' },
];
---

<header class="fixed top-0 right-0 left-0 z-50 border-b border-border bg-bg-primary/60 backdrop-blur-xl">
	<nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
		<a href="/" class="flex items-center gap-2.5 text-lg font-semibold tracking-tight">
			<Hexagon size={22} class="text-accent" />
			<span>Codemaxxing</span>
		</a>

		<div class="flex items-center gap-8">
			{
				navigationLinks.map((link) => (
					<a
						href={link.href}
						aria-current={Astro.url.pathname === link.href ? 'page' : undefined}
						class="hidden font-mono text-xs uppercase tracking-widest text-text-secondary transition-colors hover:text-accent sm:inline"
					>
						{link.label}
					</a>
				))
			}
			<a
				href={appUrl}
				class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2 text-sm font-semibold text-white transition-all hover:brightness-110"
				style="box-shadow: 0 0 20px color-mix(in srgb, var(--color-accent) 30%, transparent);"
			>
				Open IDE
				<ArrowRight size={14} stroke-width={2.5} />
			</a>
		</div>
	</nav>
</header>
