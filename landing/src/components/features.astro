---
import { Code2, Eye, GitBranch, Rocket, Sparkles, Users, type Icon as IconType } from '@lucide/astro';

interface Feature {
	title: string;
	description: string;
	icon: typeof IconType;
}

const features: Feature[] = [
	{
		title: 'Browser Editor',
		description: 'Editing, autocomplete, linting, and multi-file work in one place, right in the browser.',
		icon: Code2,
	},
	{
		title: 'Collaborate in Real-Time',
		description: 'Share a project and work together with live cursors and synced changes.',
		icon: Users,
	},
	{
		title: 'AI Agent',
		description: ' Built-in AI agent that understands your project. Generate code, debug issues, and refactor.',
		icon: Sparkles,
	},
	{
		title: 'Instant Preview',
		description: 'Each project gets a live preview URL so you can check changes as you make them, with DevTools built-in.',
		icon: Eye,
	},
	{
		title: 'Git Integration',
		description: 'Review diffs, create commits, switch branches, and push from the same workspace.',
		icon: GitBranch,
	},
	{
		title: 'Deploy',
		description: 'Deploy to Cloudflare in one click. Your app runs on 300+ data centers worldwide with zero cold starts.',
		icon: Rocket,
	},
];
---

<section id="features" class="relative py-24 sm:py-32">
	<!-- Subtle radial glow behind the section -->
	<div
		class="pointer-events-none absolute inset-0"
		aria-hidden="true"
		style="background: radial-gradient(ellipse 60% 40% at 50% 30%, color-mix(in srgb, var(--color-accent) 4%, transparent) 0%, transparent 70%);"
	>
	</div>

	<div class="relative mx-auto max-w-6xl px-6">
		<!-- Section header -->
		<div class="mx-auto mb-16 max-w-2xl text-center">
			<p class="mb-4 font-mono text-xs uppercase tracking-widest text-accent">Features</p>
			<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Build apps from your browser</h2>
			<p class="mt-4 text-lg leading-relaxed text-text-secondary">
				Start a project, edit code, preview it, and ship it without installing anything.
			</p>
		</div>

		<!-- Feature grid -->
		<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
			{
				features.map((feature, index) => (
					<div
						class="shimmer-card scroll-reveal group rounded-xl border border-border bg-bg-secondary/60 p-6 backdrop-blur-sm transition-all hover:border-accent/30 hover:bg-bg-secondary/80"
						style={`transition-delay: ${index * 80}ms;`}
						data-reveal
					>
						<feature.icon
							size={22}
							stroke-width={1.5}
							class="mb-4 inline-flex rounded-lg bg-accent/10 p-2.5 text-accent transition-colors group-hover:bg-accent/20"
						/>
						<h3 class="mb-2 text-base font-semibold">{feature.title}</h3>
						<p class="text-sm leading-relaxed text-text-secondary">{feature.description}</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<!-- Scroll-reveal observer -->
<script>
	const elements = document.querySelectorAll('[data-reveal]');

	if (elements.length > 0) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('visible');
						observer.unobserve(entry.target);
					}
				}
			},
			{ threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
		);

		for (const element of elements) {
			observer.observe(element);
		}
	}
</script>
